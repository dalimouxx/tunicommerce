[Unit]
Description=Tunicom background worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tunicom
Group=tunicom
WorkingDirectory=/srv/tunicom/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/tunicom/worker.env
ExecStart=/usr/bin/node --import tsx scripts/worker.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
