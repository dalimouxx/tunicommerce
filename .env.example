DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tunicommerce?schema=public
APP_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
# Chiffrement serveur : secret aléatoire d'au moins 32 caractères, identique pour app et worker.
APP_ENCRYPTION_SECRET=
# Envois inactifs tant que le service SMTP et le worker ne sont pas configurés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Domaine plateforme : https://votre-domaine.tn ; ne pas activer trustHostHeader.
# Le routage de domaines reste désactivé par défaut sur l'environnement Render de test.
STOREFRONT_DOMAIN_ROUTING=disabled
STOREFRONT_ROOT_DOMAIN=
# DNS système par défaut ; serveurs explicites uniquement si l'opérateur le souhaite.
DOMAIN_DNS_SERVERS=
# Sur VPS derrière reverse proxy local : 127.0.0.1. Render conserve 0.0.0.0.
BIND_HOST=0.0.0.0
