DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tunicommerce?schema=public
APP_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
# Chiffrement serveur : secret aléatoire d'au moins 32 caractères, identique pour app et worker.
APP_ENCRYPTION_SECRET=
# Envois inactifs tant que le service SMTP et le worker ne sont pas configurés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Vide par défaut : aucun webhook externe. Hôtes DNS exacts autorisés par l’exploitant, séparés par des virgules.
# HTTPS 443 uniquement ; aucune adresse privée, redirection ou destination IPv6 seule.
WEBHOOK_ALLOWED_HOSTS=
# En production : APP_URL=https://tunicom.shop ; ne pas activer trustHostHeader.
# Routage local désactivé par défaut ; en production : enabled et racine tunicom.shop.
STOREFRONT_DOMAIN_ROUTING=disabled
STOREFRONT_ROOT_DOMAIN=
# DNS système par défaut ; serveurs explicites uniquement si l'opérateur le souhaite.
DOMAIN_DNS_SERVERS=
# Écoute conteneur : 0.0.0.0 ; accès public via le proxy HTTPS uniquement.
BIND_HOST=0.0.0.0
# Transition médias : database par défaut. Utiliser uniquement un stockage privé persistant pour les fichiers.
# filesystem-mirror conserve les originaux PostgreSQL et préfère leurs copies privées vérifiées.
# filesystem-primary permet en plus de libérer la base (commande release, après une sauvegarde des photos de moins de 30 h).
MEDIA_STORAGE_MODE=database
# Répertoire canonique précréé, privé, persistant, hors de public/ et réservé à Tunicom.
MEDIA_STORAGE_ROOT=
# Nettoyage des seules copies sans référence, après 7 jours : désactivé jusqu’à configuration VPS.
MEDIA_GC_ENABLED=false
