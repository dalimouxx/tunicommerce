{
  "name": "tunicommerce",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "node scripts/start.mjs",
    "worker": "node --import tsx scripts/worker.ts",
    "worker:health": "node --import tsx scripts/worker-health.ts",
    "catalog:verify": "node --import tsx scripts/catalog-index.ts",
    "media:storage": "node --import tsx scripts/media-storage.ts",
    "media:cleanup": "node --import tsx scripts/media-cleanup.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-suite.mjs unit",
    "test:integration": "node --import tsx --test tests/postgres.test.ts",
    "test:integration:all": "node scripts/test-suite.mjs integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
