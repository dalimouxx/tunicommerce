generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id @default(uuid())
  email        String @unique
  name         String
  role         String @default("MERCHANT")
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  workspace    Workspace?
  memberships  Membership[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
}
model Session {
  tokenHash String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Workspace {
  id        String @id @default(uuid())
  slug      String? @unique
  published Boolean @default(false)
  plan      String @default("STARTER")
  subscriptionStatus String @default("TRIAL")
  subscriptionEndsAt DateTime?
  receipts PublicReceipt[]
  shop Shop?
  ownerId   String @unique
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  data      Json
  version   Int @default(0)
  updatedAt DateTime @updatedAt
}
model SetupLock {
  id        Int @id
  createdAt DateTime @default(now())
}
model AuthThrottle {
  key       String @id
  count     Int
  expiresAt DateTime
}

model PublicReceipt {
 id String @id @default(uuid())
 workspaceId String
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 requestId String
 reference String
 total Int
 createdAt DateTime @default(now())
 @@unique([workspaceId, requestId])
}
model PlatformAudit {
 id String @id @default(uuid())
 actorId String
 workspaceId String
 detail String
 createdAt DateTime @default(now())
}

model Organization {
  id        String @id @default(uuid())
  name      String
  ownerId   String
  owner     User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId])
}

model Shop {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legacyWorkspaceId String? @unique
  legacyWorkspace Workspace? @relation(fields: [legacyWorkspaceId], references: [id], onDelete: SetNull)
  name           String
  slug           String @unique
  status         String @default("DRAFT")
  currency       String @default("TND")
  language       String @default("fr")
  timezone       String @default("Africa/Tunis")
  memberships    Membership[]
  invitations    ShopInvitation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
}

model Membership {
  id        String @id @default(uuid())
  shopId    String
  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String @default("VIEWER")
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([shopId,userId])
  @@index([userId,active])
}

model ShopInvitation {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email       String
  role        String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, email])
  @@index([email, acceptedAt, revokedAt, expiresAt])
}
