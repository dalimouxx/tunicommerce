generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
model User {
  id           String @id @default(uuid())
  email        String @unique
  name         String
  role         String @default("MERCHANT")
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  workspace    Workspace?
  memberships  Membership[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  emailVerifiedAt DateTime?
  accountTokens AccountActionToken[]
  securityEvents AccountSecurityEvent[]
  authVersion Int @default(0)
  mfaSecret String?
  mfaEnabledAt DateTime?
  mfaLastStep Int?
  mfaPendingSecret String?
  mfaPendingExpiresAt DateTime?
  recoveryCodes MfaRecoveryCode[]
}
model Session {
  tokenHash String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  authVersion Int @default(0)
  @@index([userId])
  @@index([expiresAt])
}
model Workspace {
  id        String @id @default(uuid())
  slug      String? @unique
  published Boolean @default(false)
  plan      String @default("STARTER")
  subscriptionStatus String @default("TRIAL")
  subscriptionEndsAt DateTime?
  receipts PublicReceipt[]
  shop Shop?
  media ShopMedia[]
  productMedia ProductMedia[]
  planOverride WorkspacePlanOverride?
  subscriptionPayments SubscriptionPayment[]
  ownerId   String @unique
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  data      Json
  version   Int @default(0)
  updatedAt DateTime @updatedAt
}
model SetupLock {
  id        Int @id
  createdAt DateTime @default(now())
}
model AuthThrottle {
  key       String @id
  count     Int
  expiresAt DateTime
}

model PublicReceipt {
 id String @id @default(uuid())
 workspaceId String
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 requestId String
 reference String
 total Int
 createdAt DateTime @default(now())
 @@unique([workspaceId, requestId])
}
model PlatformAudit {
 id String @id @default(uuid())
 actorId String
 workspaceId String
 detail String
 createdAt DateTime @default(now())
}

model Organization {
  id        String @id @default(uuid())
  name      String
  ownerId   String
  owner     User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId])
}

model Shop {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legacyWorkspaceId String? @unique
  legacyWorkspace Workspace? @relation(fields: [legacyWorkspaceId], references: [id], onDelete: SetNull)
  name           String
  slug           String @unique
  status         String @default("DRAFT")
  currency       String @default("TND")
  language       String @default("fr")
  timezone       String @default("Africa/Tunis")
  memberships    Membership[]
  invitations    ShopInvitation[]
  commerce       ShopCommerce?
  home           ShopHome?
  pages          ShopPage[]
  domainClaims   ShopDomainClaim[]
  domainBindings ShopDomainBinding[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
}

model Membership {
  id        String @id @default(uuid())
  shopId    String
  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String @default("VIEWER")
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([shopId,userId])
  @@index([userId,active])
}

model ShopInvitation {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email       String
  role        String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, email])
  @@index([email, acceptedAt, revokedAt, expiresAt])
}

/** Tiny, bounded brand assets. Do not store product photos or unrestricted media here. */
model ShopMedia {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slot        String
  mimeType    String
  content     Bytes
  size        Int
  width       Int
  height      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, slot])
}

/**
 * Limited merchant product-photo library. 30 images of <= 400 KiB each.
 * Stored separately from products, orders and the existing ShopMedia logo/banner.
 * Move blobs to Neon object storage when Render storage credentials are provisioned.
 */
model ProductMedia {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mimeType    String
  content     Bytes
  size        Int
  width       Int
  height      Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

/** SaaS billing configuration only; payments are not taken by the application. */
model SubscriptionPlan {
  code               String   @id
  name               String
  description        String   @default("")
  priceMillimes      Int      @default(0)
  durationDays       Int      @default(30)
  maxProducts        Int?
  maxOrdersPerMonth  Int?
  maxPhotos          Int?
  maxShops           Int?
  maxMembers         Int?
  modules            Json     @default("{}")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/** Optional per-workspace exceptions. NULL = inherit; 0 = unlimited (physical 30-photo safety cap remains). */
model WorkspacePlanOverride {
  workspaceId         String    @id
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  maxProducts         Int?
  maxOrdersPerMonth   Int?
  maxPhotos           Int?
  note                String    @default("")
  updatedAt           DateTime  @updatedAt
}

/** Immutable audit snapshots for plan-catalog edits (distinct from merchant events). */
model SubscriptionPlanAudit {
 id          String   @id @default(uuid())
 actorId     String
 planCode    String
 details     Json
 createdAt   DateTime @default(now())
 @@index([planCode, createdAt])
}

/**
 * Manual declaration + administrative verification of an external SaaS payment.
 * A request is NEVER proof of payment and cannot renew a subscription itself.
 * This record is not a fiscal invoice until legal issuer/tax details are configured.
 */
model SubscriptionPayment {
  id                String    @id @default(uuid())
  reference         String    @unique
  requestId         String
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requesterId       String
  planCode          String
  planName          String
  priceMillimes     Int
  durationDays      Int
  method            String
  transferReference String?
  merchantNote      String    @default("")
  status            String    @default("PENDING")
  adminNote         String    @default("")
  decidedById       String?
  decidedAt         DateTime?
  periodStartsAt    DateTime?
  periodEndsAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, requestId])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

/**
 * Public-facing instructions for receiving external SaaS payments.
 * No payment credentials, card data, API keys or automatic charges.
 * Methods start disabled until a global ADMIN configures real details.
 */
model PaymentReceptionMethod {
  code          String   @id
  enabled       Boolean  @default(false)
  recipientName String   @default("")
  identifier    String   @default("")
  bankName      String   @default("")
  instructions  String   @default("")
  version       Int      @default(0)
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

/** Global configuration changes, not attached to merchant workspaces. */
model PaymentReceptionAudit {
  id          String   @id @default(uuid())
  actorId     String
  methodCode  String
  oldVersion  Int
  nextVersion Int
  changed     Json
  createdAt   DateTime @default(now())

  @@index([methodCode, createdAt])
}


/** Isolated commercial workspace for newly created shops. Legacy Workspace remains untouched. */
model ShopCommerce {
  shopId    String @id
  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  data      Json
  version   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountActionToken {
 tokenHash String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 purpose String
 email String
 expiresAt DateTime
 consumedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([userId,purpose])
 @@index([expiresAt])
}

model AccountSecurityEvent {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 kind String
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}

model BackgroundJob {
 id String @id @default(uuid())
 kind String
 status String @default("PENDING")
 subjectKey String
 dedupKey String @unique
 payload String?
 attempts Int @default(0)
 maxAttempts Int @default(4)
 availableAt DateTime @default(now())
 leaseId String?
 lockedUntil DateTime?
 errorCode String?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 @@index([status,availableAt])
 @@index([subjectKey,status])
}

model MfaRecoveryCode {
 codeHash String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 usedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId])
}

/** Draft and public snapshot are deliberately independent. Slugs stay stable after creation. */
model ShopPage {
 id String @id @default(uuid())
 shopId String
 shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
 slug String
 draft Json
 published Json?
 version Int @default(0)
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shopId,slug])
 @@index([shopId,publishedAt])
}

model ShopDomainClaim {
 id String @id @default(uuid())
 shopId String
 shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
 hostname String
 token String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 binding ShopDomainBinding?
 @@unique([shopId,hostname])
 @@index([shopId])
}

model ShopDomainBinding {
 hostname String @id
 shopId String
 shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
 claimId String @unique
 claim ShopDomainClaim @relation(fields:[claimId],references:[id],onDelete:Cascade)
 verifiedAt DateTime
 @@index([shopId])
}

/** Independent storefront homepage: a saved draft never alters the published snapshot. */
model ShopHome {
  shopId String @id
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  draft Json
  published Json?
  version Int @default(1)
  publishedVersion Int?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
