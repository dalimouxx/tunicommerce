generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id @default(uuid())
  email        String @unique
  name         String
  role         String @default("MERCHANT")
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  workspace    Workspace?
  purchases    PublicReceipt[] @relation("CustomerPurchases")
}
model Session {
  tokenHash String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Workspace {
  id        String @id @default(uuid())
  slug      String? @unique
  published Boolean @default(false)
  plan      String @default("STARTER")
  subscriptionStatus String @default("TRIAL")
  subscriptionEndsAt DateTime?
  receipts PublicReceipt[]
  ownerId   String @unique
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  data      Json
  version   Int @default(0)
  updatedAt DateTime @updatedAt
}
model SetupLock {
  id        Int @id
  createdAt DateTime @default(now())
}
model AuthThrottle {
  key       String @id
  count     Int
  expiresAt DateTime
}

model PublicReceipt {
 id String @id @default(uuid())
 customerId String?
 customer User? @relation("CustomerPurchases", fields: [customerId], references: [id], onDelete: SetNull)
 workspaceId String
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 requestId String
 reference String
 total Int
 createdAt DateTime @default(now())
 @@unique([workspaceId, requestId])
 @@index([customerId, createdAt])
}
model PlatformAudit {
 id String @id @default(uuid())
 actorId String
 workspaceId String
 detail String
 createdAt DateTime @default(now())
}
